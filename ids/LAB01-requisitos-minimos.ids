<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>LAB01 - Requisitos mínimos de entrega (arquitectura)</title>
        <version>1.1.0</version>
        <description>Generado desde la matriz de requisitos de LAB01. Clase: DIDACTICO. No editar a mano: modificar la matriz y regenerar.</description>
        <author>sebastz3120@gmail.com</author>
        <date>2026-11-06</date>
        <purpose>Aprendizaje: control de calidad de entregables según ISO 19650</purpose>
        <milestone>Diseño - Entrega 01</milestone>
    </info>
    <specifications>
        <specification name="R01 - Código de proyecto" ifcVersion="IFC4" identifier="R01" description="El IfcProject debe llevar el código asignado al proyecto. | Responde a PIR-01: ¿La entrega pertenece a este proyecto? | Fuente: Ejemplo del laboratorio (DIDACTICO)" instructions="Escriba el código del proyecto (ej. LAB01) en el nombre del proyecto antes de exportar.">
            <applicability minOccurs="1" maxOccurs="1">
                <entity>
                    <name>
                        <simpleValue>IFCPROJECT</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="[A-Z]{3}[0-9]{2}" />
                        </xs:restriction>
                    </value>
                </attribute>
            </requirements>
        </specification>
        <specification name="R02 - Niveles definidos" ifcVersion="IFC4" identifier="R02" description="El modelo debe contener al menos un nivel, y cada nivel debe tener nombre. | Responde a PIR-02: ¿En qué nivel del edificio está cada elemento? | Fuente: Ejemplo del laboratorio (DIDACTICO)" instructions="Defina los niveles del edificio y asigne un nombre a cada uno.">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
        <specification name="R03 - Nomenclatura de muros" ifcVersion="IFC4" identifier="R03" description="Debe haber muros, y cada IfcWall debe nombrarse MUR-### (ej. MUR-001). | Responde a PIR-03: ¿Se puede identificar cada muro en planos y metrados? | Fuente: Ejemplo del laboratorio (DIDACTICO)" instructions="Nombre cada muro con el prefijo MUR- seguido de tres dígitos.">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="MUR-[0-9]{3}" />
                        </xs:restriction>
                    </value>
                </attribute>
            </requirements>
        </specification>
        <specification name="R04 - Propiedades obligatorias de muros" ifcVersion="IFC4" identifier="R04" description="Todo IfcWall debe declarar si es exterior y si es portante. | Responde a PIR-04: ¿Qué muros son exteriores y cuáles son portantes? | Fuente: Ejemplo del laboratorio (DIDACTICO)" instructions="Complete IsExternal y LoadBearing en Pset_WallCommon antes de exportar.">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property dataType="IFCBOOLEAN" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>IsExternal</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCBOOLEAN" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>LoadBearing</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
        <specification name="R05 - Elevación de niveles" ifcVersion="IFC4" identifier="R05" description="Cada nivel debe declarar su elevación. | Responde a PIR-05: ¿A qué altura está cada nivel? | Fuente: Ejemplo del laboratorio (DIDACTICO)" instructions="Asigne la elevación de cada nivel (en metros) antes de exportar.">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Elevation</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
    </specifications>
</ids>